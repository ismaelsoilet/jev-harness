{
  "name": "@ismaelsoilet/jev-harness",
  "version": "0.1.3",
  "description": "Zero-dependency System One decision harness and token optimizer for AI coding agents (OpenCode, Cursor, Claude Code).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "jev-harness": "bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ismaelsoilet/jev-harness.git",
    "directory": "packages/ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test dist-test/tests/*.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "typesafe",
    "jev",
    "system-one",
    "agentic-ai",
    "token-optimizer",
    "mcp",
    "opencode",
    "cursor"
  ],
  "author": "Ismael Hosni Soilet de Lima <soilet.ismael@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
